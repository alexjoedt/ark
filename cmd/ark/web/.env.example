# API URL for development.
# In production (embedded in arkUI), leave empty to use relative URLs.
# When running the Vite dev server, the proxy in vite.config.ts forwards
# /api and /ws to http://localhost:8080 automatically, so this variable
# is only needed if you want to point at a non-default backend host.
#
# VITE_API_URL=http://localhost:8080
